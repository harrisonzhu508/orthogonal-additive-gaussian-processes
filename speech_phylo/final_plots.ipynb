    "import dendropy\n",
    "import numpy as np\n",
    "\n",
    "def load_tree(path):\n",
    "    return dendropy.Tree.get(\n",
    "        path=path,\n",
    "        schema=\"nexus\",\n",
    "        preserve_underscores=True,\n",
    "        extract_comment_metadata=True,\n",
    "    )\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "def leaf_rates(tree, key=\"rate\"):\n",
    "    out = {}\n",
    "    for leaf in tree.leaf_node_iter():\n",
    "        # Most BEAST MCC trees: comments after branch length -> edge annotations\n",
    "        ann = leaf.edge.annotations.get_value(key, None)\n",
    "        # Fallback: some formats attach to the node\n",
    "        if ann is None:\n",
    "            ann = leaf.annotations.get_value(key, None)\n",
    "        out[leaf.taxon.label] = float(ann) if ann is not None else None\n",
    "    return out\n",
    "\n",
    "raw_rates    = leaf_rates(raw_tree,    key=\"rate\")  # change key if you saw rate_mean, etc.\n",
    "pruned_rates = leaf_rates(pruned_tree, key=\"rate\")\n",
    "\n",
    "\n",
    "raw_tree    = load_tree(\"heggarty2024_raw.nex\")\n",
    "pruned_tree = load_tree(\"heggarty2024.nex\")  # or the .newick if you prefer\n",
    "\n",
    "raw_rates    = leaf_rates(raw_tree)\n",
    "pruned_rates = leaf_rates(pruned_tree)\n",
    "\n",
    "common_taxa = sorted(set(pruned_rates) & set(raw_rates))\n",
    "\n",
    "common_taxa = sorted(set(raw_rates) & set(pruned_rates))\n",
    "\n",
    "for t in common_taxa:\n",
    "    r_raw    = raw_rates[t]\n",
    "    r_pruned = pruned_rates[t]\n",
    "\n",
    "    if r_raw is None and r_pruned is None:\n",
    "        status = \"both NA\"\n",
    "    elif r_raw is None:\n",
    "        status = \"raw NA, pruned has value\"\n",
    "    elif r_pruned is None:\n",
    "        status = \"pruned NA, raw has value\"\n",
    "    else:\n",
    "        status = f\"Δ={r_pruned - r_raw:.3g}\"\n",
    "\n",
    "    print(f\"{t:5s}  raw={r_raw if r_raw is not None else 'NA':>12}  \"\n",
    "          f\"pruned={r_pruned if r_pruned is not None else 'NA':>12}  {status}\")\n",
    "\n"
