    "    \"log_n_speakers\": \"#2ca02c\",\n",
    "    \"Longitude×Latitude\": \"#d62728\",\n",
    "    \"Latitude×log_n_speakers\": \"#e377c2\",\n",
    "    \"Longitude×log_n_speakers\": \"#9467bd\",\n",
    "    \"Phylogenetic\": \"#8c564b\",\n",
    "    \"Residual\": \"#7f7f7f\",\n",
    "}\n",
    "\n",
    "# Map CSV column names to display names\n",
    "CSV_TO_DISPLAY = {\n",
    "    \"var_longitude_norm\": \"Longitude\",\n",
    "    \"var_latitude_norm\": \"Latitude\",\n",
    "    \"var_log_n_speakers_norm\": \"log_n_speakers\",\n",
    "    \"var_longitude_norm_latitude_norm\": \"Longitude×Latitude\",\n",
    "    \"var_latitude_norm_log_n_speakers_norm\": \"Latitude×log_n_speakers\",\n",
    "    \"var_longitude_norm_log_n_speakers_norm\": \"Longitude×log_n_speakers\",\n",
    "}\n",
    "\n",
    "\n",
    "def load_phylo_variance_results(csv_dir: str, coord_method: str = \"standard\") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Load variance decomposition from phylogenetic regression CSVs.\n",
    "    \"\"\"\n",
    "    pattern = os.path.join(csv_dir, f\"phylolm_*_{coord_method}.csv\")\n",
    "    csv_files = glob.glob(pattern)\n",
    "    \n",
    "    if not csv_files:\n",
    "        print(f\"No CSV files found matching {pattern}\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    records = []\n",
    "    \n",
    "    for csv_path in csv_files:\n",
    "        df = pd.read_csv(csv_path)\n",
    "        tree_name = df[\"tree\"].iloc[0]\n",
    "        \n",
    "        # Get overall proportions\n",
    "        phylo_prop = df[\"phylo_prop_mean\"].iloc[0]\n",
    "        residual_prop = df[\"residual_prop_mean\"].iloc[0]\n",
    "        fixed_prop = df[\"fixed_prop_mean\"].iloc[0]\n",
    "        \n",
    "        # Get per-term variances and normalize them to proportions of total\n",
    "        term_vars = {}\n",
    "        for csv_col, display_name in CSV_TO_DISPLAY.items():\n",
    "            if csv_col in df.columns:\n",
    "                term_vars[display_name] = df[csv_col].iloc[0]\n",
    "        \n",
    "        # Sum of per-term variances (may not equal fixed_var due to covariances)\n",
    "        term_var_sum = sum(term_vars.values())\n",
    "        \n",
    "        # Scale per-term variances so they sum to fixed_prop\n",
    "        # This distributes the fixed effects proportion among individual terms\n",
    "        if term_var_sum > 0:\n",
    "            for comp, var in term_vars.items():\n",
    "                scaled_prop = (var / term_var_sum) * fixed_prop\n",
    "                records.append({\n",
    "                    \"tree\": tree_name,\n",
    "                    \"component\": comp,\n",
    "                    \"variance_prop\": scaled_prop,\n",
    "                })\n",
    "        \n",
    "        # Add phylogenetic and residual directly as proportions\n",
    "        records.append({\n",
    "            \"tree\": tree_name,\n",
    "            \"component\": \"Phylogenetic\",\n",
    "            \"variance_prop\": phylo_prop,\n",
    "        })\n",
    "        records.append({\n",
    "            \"tree\": tree_name,\n",
    "            \"component\": \"Residual\",\n",
    "            \"variance_prop\": residual_prop,\n",
    "        })\n",
    "    \n",
    "    return pd.DataFrame(records)\n",
    "\n",
    "def plot_phylo_variance_stacked(\n",
    "    csv_dir: str = \"speech_phylo/final_phyloregression_results\",\n",
    "    coord_method: str = \"standard\",\n",
    "    tree_order: list = None,\n",
    "    tree_labels: dict = None,  # e.g., {\"heggarty2024\": \"Speech\", \"long_v3_CCD0.0.25\": \"Cognates\"}\n",
    "    output_dir: str = \"final_figuresv2\",\n",
    "    file_stub: str = \"phylo_variance_stacked\",\n",
    ") -> None:\n",
    "    \"\"\"Plot variance decomposition as stacked horizontal bars per tree.\"\"\"\n",
    "    \n",
    "    df = load_phylo_variance_results(csv_dir, coord_method)\n",
    "    \n",
    "    if df.empty:\n",
    "        print(\"No data to plot.\")\n",
    "        return\n",
    "    \n",
    "    # Pivot to get components as columns\n",
    "    summary = df.pivot_table(\n",
    "        index=\"tree\", \n",
    "        columns=\"component\", \n",
    "        values=\"variance_prop\", \n",
    "        aggfunc=\"mean\"\n",
    "    ).fillna(0.0)\n",
    "    \n",
    "    # print summary nicely\n",
    "    print(\"Variance decomposition summary:\")\n",
    "    print(summary)\n",
    "\n",
    "    \n",
    "    # Ensure all components exist\n",
    "    for comp in VARIANCE_COMPONENT_ORDER:\n",
    "        if comp not in summary.columns:\n",
    "            summary[comp] = 0.0\n",
    "    summary = summary[VARIANCE_COMPONENT_ORDER]\n",
    "    \n",
    "    # Reorder trees\n",
    "    if tree_order is not None:\n",
    "        summary = summary.reindex(tree_order).fillna(0.0)\n",
    "    \n",
    "    # Rename trees for display\n",
    "    if tree_labels is not None:\n",
    "        summary.index = [tree_labels.get(t, t) for t in summary.index]\n",
    "    \n",
    "    # Plot\n",
    "    fig_height = max(3.8, 1.35 * len(summary.index))\n",
    "    fig, ax = plt.subplots(figsize=(12, fig_height))\n",
    "    \n",
    "    y_positions = np.arange(len(summary.index))\n",
    "    left = np.zeros(len(summary.index))\n",
    "    \n",
    "    for comp in VARIANCE_COMPONENT_ORDER:\n",
    "        values = summary[comp].to_numpy(dtype=float)\n",
    "        if np.allclose(values, 0.0):\n",
    "            continue\n",
    "        \n",
    "        bars = ax.barh(\n",
    "            y_positions,\n",
    "            values,\n",
    "            left=left,\n",
    "            height=0.6,\n",
    "            color=VARIANCE_COLORS.get(comp, \"#999999\"),\n",
    "            edgecolor=\"white\",\n",
    "            linewidth=0.8,\n",
    "            label=comp,\n",
    "        )\n",
    "        \n",
    "        # Add value labels\n",
    "        for bar in bars:\n",
    "            width = bar.get_width()\n",
    "            if width < 0.05:\n",
    "                continue\n",
    "            ax.text(\n",
    "                bar.get_x() + width / 2.0,\n",
    "                bar.get_y() + bar.get_height() / 2.0,\n",
    "                f\"{width:.2f}\",\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "                fontsize=12,\n",
    "                color=\"white\",\n",
    "                fontweight=\"bold\",\n",
    "                clip_on=False,\n",
    "            )\n",
    "        left += values\n",
    "    \n",
    "    ax.set_yticks(y_positions)\n",
    "    ax.set_yticklabels(summary.index, fontsize=18)\n",
    "    ax.set_xlabel(\"Proportion of variance\", fontsize=18)\n",
    "    ax.set_xlim(0, 1.02)\n",
    "    ax.tick_params(axis=\"x\", labelsize=16)\n",
    "    ax.grid(axis=\"x\", linestyle=\"--\", color=\"#bcbcbc\", alpha=0.4)\n",
    "    ax.set_axisbelow(True)\n",
    "    \n",
    "    # Total labels\n",
    "    totals = summary.sum(axis=1).to_numpy()\n",
    "    for ypos, total in zip(y_positions, totals):\n",
    "        ax.text(1.005, ypos, f\"{total:.2f}\", va=\"center\", ha=\"left\", fontsize=13, color=\"#333333\")\n",
    "    \n",
    "    legend = ax.legend(\n",
    "        loc=\"upper center\", bbox_to_anchor=(0.5, -0.28), ncol=4, frameon=False, fontsize=15\n",
    "    )\n",
    "    if legend is not None:\n",
    "        for text in legend.get_texts():\n",
    "            text.set_fontsize(14)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    pdf_path = os.path.join(output_dir, f\"{file_stub}.svg\")\n",
    "    # plt.savefig(pdf_path, dpi=300, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
